# Copy to .env and fill in. Without a key the system runs fully offline (rules only).
LLM_PROVIDER=auto            # auto | grok | openai | offline
XAI_API_KEY=
XAI_MODEL=grok-4             # any Grok model your key can access
# XAI_VISION_MODEL=          # model for scanned invoices and photos; blank = XAI_MODEL
# XAI_MODEL_FAST=            # reading text + drafting emails; blank = XAI_MODEL (see docs.x.ai for model names)
# XAI_MODEL_REASONING=       # investigator, VP, auditor; blank = XAI_MODEL
# XAI_BASE_URL=https://api.x.ai/v1

# Optional alternative (any OpenAI-compatible endpoint)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# AP_USE_OCR=1                # use local Tesseract OCR for scans when installed (0 to disable)
# AP_APPROVAL_THRESHOLD=10000
# AP_READ_WORKERS=4           # files read in parallel in a batch (decisions stay in order)
# AP_FAST_PATH=1              # clean structured invoices skip the auditor round (0 to disable)
# AP_DB_PATH=inventory.db
